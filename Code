#include <stdio.h>

 

#define MAX 10

#define INF 999

 

int main() {

   int n, cost[MAX][MAX], dist[MAX][MAX];

   int nextHop[MAX][MAX];

   int i, j, k, updated;

   int src, dest, current;

 

   printf("Enter number of routers: ");

   scanf("%d", &n);

 

   printf("Enter cost matrix (use 999 for INF):\n");

 

   for (i = 0; i < n; i++) {

       for (j = 0; j < n; j++) {

           scanf("%d", &cost[i][j]);

           dist[i][j] = cost[i][j];

 

           if (i == j) {

               dist[i][j] = 0;

               nextHop[i][j] = i;

           } else if (cost[i][j] != INF) {

               nextHop[i][j] = j;

           } else {

               nextHop[i][j] = -1;

           }

       }

   }

 

   do {

       updated = 0;

 

       for (i = 0; i < n; i++) {

           for (j = 0; j < n; j++) {

               for (k = 0; k < n; k++) {

                   if (cost[i][k] != INF &&

                       dist[k][j] != INF &&

                       dist[i][k] + dist[k][j] < dist[i][j]) {

 

                       dist[i][j] = dist[i][k] + dist[k][j];

                       nextHop[i][j] = k;

                       updated = 1;

                   }

               }

           }

       }

   } while (updated);

 

   printf("\nFinal Routing Tables:\n");

 

   for (i = 0; i < n; i++) {

       printf("\nRouter %d\n", i);

 

       printf("Destination\tCost\tNext Hop\n");

 

       for (j = 0; j < n; j++) {

           printf("%d\t\t", j);

 

           if (dist[i][j] == INF)

               printf("INF\t");

           else

               printf("%d\t", dist[i][j]);

 

           if (nextHop[i][j] == -1)

               printf("-\n");

           else

               printf("%d\n", nextHop[i][j]);

       }

   }

 

   printf("\nEnter source router: ");

   scanf("%d", &src);

 

   printf("Enter destination router: ");

   scanf("%d", &dest);

 

   if (dist[src][dest] == INF) {

       printf("No path exists between the routers.\n");

   } else {

       printf("Minimum Cost: %d\n", dist[src][dest]);

       printf("Shortest Path: %d", src);

 

       current = src;

 

       while (current != dest) {

           current = nextHop[current][dest];

 

           if (current == -1) {

               printf("\nPath cannot be determined.\n");

               return 0;

           }

 

           printf(" -> %d", current);

       }

 

       printf("\n");

   }

 

   return 0;

}

